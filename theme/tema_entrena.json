{
  "name": "Entrena Consulting",
  "dataColors": [
    "#F26522",
    "#2E7D32",
    "#66BB6A",
    "#FDD835",
    "#FB8C00",
    "#C62828",
    "#6B7280",
    "#1F2937"
  ],
  "foreground": "#1F2937",
  "background": "#FFFFFF",
  "tableAccent": "#F26522",
  "good": "#2E7D32",
  "neutral": "#FDD835",
  "bad": "#C62828",
  "maximum": "#C62828",
  "center": "#FDD835",
  "minimum": "#2E7D32",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#F26522"
    },
    "title": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#F26522"
    },
    "header": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#374151"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7280"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#C62828"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "icon": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "lineColor": {
              "solid": {
                "color": "#C62828"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "calloutValue": [
          {
            "color": {
              "solid": {
                "color": "#F26522"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "general": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#1F2937"
              }
            }
          }
        ]
      }
    }
  }
}